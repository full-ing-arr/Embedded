ADC_CONTROLLER(ADC_RTC1, ADC_UNIT_1, ADC_ONESHOT | ADC_ULP, ADC_RTC_CLOCK | ADC1_MUX, ADC_DRIVER_AVAILABLE)
ADC_CONTROLLER(ADC_RTC2, ADC_UNIT_2, ADC_ONESHOT | ADC_ULP, ADC_RTC_CLOCK | ADC2_ARBITER, ADC_DRIVER_AVAILABLE)
ADC_CONTROLLER(ADC_DIG1, ADC_UNIT_1, ADC_SCAN | ADC_DMA, ADC_DIG_CLOCK | ADC_DIG_TRIGGER | ADC_DIG_DATA | ADC1_MUX, ADC_DRIVER_AVAILABLE)
// ADC-183: the ADC2 digital controller produces unstable results.
ADC_CONTROLLER(ADC_DIG2, ADC_UNIT_2, ADC_SCAN | ADC_DMA, ADC_DIG_CLOCK | ADC_DIG_TRIGGER | ADC_DIG_DATA | ADC2_ARBITER, ADC_DRIVER_UNAVAILABLE)
// PWDET belongs to the internal RF subsystem.
ADC_CONTROLLER(ADC_PWDET, ADC_UNIT_2, ADC_RF, ADC_RF_CLOCK | ADC2_ARBITER, ADC_DRIVER_UNAVAILABLE)
